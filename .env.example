# Copie para .env e preencha. Nunca commite o .env.
# Gerar chave: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY='troque-por-uma-chave-aleatoria'
# True apenas em desenvolvimento local
DEBUG=False
# Separados por vírgula (em produção: o IP público do servidor)
ALLOWED_HOSTS=127.0.0.1,localhost
# True somente em produção, atrás do Nginx (que deve enviar X-Real-IP)
BEHIND_PROXY=False
# Produção: banco e cache fora da pasta do código (o deploy não pode sobrescrevê-los)
# DATABASE_PATH=/var/lib/coletta/db.sqlite3
# CACHE_DIR=/var/lib/coletta/cache
